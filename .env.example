# Password required to reach the showtime editor (/). Required in
# production — if unset, a random one is generated at startup and printed
# to the logs.
ADMIN_PASSWORD=change-me

# Password required to reach the friend-facing reservation page (/reserve),
# where anyone who has it can claim an open seat. Give this one out to your
# friends; keep ADMIN_PASSWORD to yourself. Required in production — if
# unset, a random one is generated at startup and printed to the logs.
SHARED_PASSWORD=change-me-three

# Secret used to sign the admin and shared session cookies. Any long random
# string works, e.g. `openssl rand -hex 32`. If unset, one is generated at
# startup, but sessions won't survive a restart.
SESSION_SECRET=change-me-too

# Port the server listens on. Coolify usually injects this automatically.
PORT=3000

# Where showtime data is persisted as a JSON file. Point this at a mounted
# volume in production so data survives redeploys.
DATA_DIR=./data
