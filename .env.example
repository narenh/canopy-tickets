# Everyone, the admin included, signs in with their Canopy account
# (account.canopysf.com). Tickets asks the account service who's visiting.

# Where the account service is. This is the default.
CANOPY_ACCOUNT_URL=https://account.canopysf.com

# This site's key for the account service, from the account admin's
# Sites tab (site name: tickets). Shown once when it's made. Required:
# without it nobody can sign in (the server says so loudly at startup).
CANOPY_ACCOUNT_KEY=cnp_change-me

# What the account service signs its calendar requests with, shown once
# in its Sites tab when tickets' Calendar URL is saved. Optional: with
# it, people's showtimes are in their one Canopy calendar link and
# that's the link offered here; without it, tickets offers its own feed.
# CANOPY_CALENDAR_SECRET=

# NOTE: movie passwords are set per movie in the editor, not here.

# NOTE: there's no env var for Venmo/Cash App either. Both are set (and
# can be changed any time) from the "Payment Handles" field in the admin
# editor, below the showtimes list -- persisted in DATA_DIR, not here.
# Either, both, or neither can be set; the reservation page only shows a
# pay button for the one(s) that are.

# Port the server listens on. Coolify usually injects this automatically.
PORT=3000

# Where showtime data (and the friend password, uploaded images, etc.)
# is persisted. Point this at a mounted volume in production so data
# survives redeploys.
DATA_DIR=./data
