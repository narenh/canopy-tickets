# There's one URL and one login form (/). Which password you type
# decides where you land.

# Opens the showtime editor. Keep this one to yourself. Required in
# production -- if unset, a random one is generated at startup and
# printed to the logs.
ADMIN_PASSWORD=change-me

# NOTE: there is no env var for the friend-facing password anymore.
# It's set (and can be changed any time, e.g. a fresh one per movie)
# from the "Friend Password" field in the admin editor, below the
# showtimes list -- persisted in DATA_DIR, not here. Until you set one
# there, friend login is off.

# NOTE: there's no env var for Venmo/Cash App either. Both are set (and
# can be changed any time) from the "Payment Handles" field in the admin
# editor, below the showtimes list -- persisted in DATA_DIR, not here.
# Either, both, or neither can be set; the reservation page only shows a
# pay button for the one(s) that are.

# Secret used to sign the admin and shared session cookies. Any long random
# string works, e.g. `openssl rand -hex 32`. Recommended but not strictly
# required -- if unset, one is derived deterministically from
# ADMIN_PASSWORD instead, so sessions still survive restarts/redeploys
# either way. Set this explicitly so that changing ADMIN_PASSWORD later
# doesn't also silently log everyone out.
SESSION_SECRET=change-me-too

# Port the server listens on. Coolify usually injects this automatically.
PORT=3000

# Where showtime data (and the friend password, uploaded images, etc.)
# is persisted. Point this at a mounted volume in production so data
# survives redeploys.
DATA_DIR=./data
