# There's one URL and one login form (/). Which of these two passwords
# you type decides where you land.

# Opens the showtime editor. Keep this one to yourself. Required in
# production -- if unset, a random one is generated at startup and
# printed to the logs.
ADMIN_PASSWORD=change-me

# Opens the friend-facing reservation page, where anyone who has it can
# claim an open seat. Give this one out to friends. Required in
# production -- if unset, a random one is generated at startup and
# printed to the logs.
SHARED_PASSWORD=change-me-three

# Your Venmo username, without the leading @. Used to build a one-tap
# "Pay via Venmo" link (with the seat's price and a note pre-filled)
# shown right after someone claims a seat. Optional -- if unset, that
# link is just skipped.
HOST_VENMO=your-venmo-username

# Secret used to sign the admin and shared session cookies. Any long random
# string works, e.g. `openssl rand -hex 32`. Recommended but not strictly
# required -- if unset, one is derived deterministically from
# ADMIN_PASSWORD/SHARED_PASSWORD instead, so sessions still survive
# restarts/redeploys either way. Set this explicitly so that changing
# either password later doesn't also silently log everyone out.
SESSION_SECRET=change-me-too

# Port the server listens on. Coolify usually injects this automatically.
PORT=3000

# Where showtime data is persisted as a JSON file. Point this at a mounted
# volume in production so data survives redeploys.
DATA_DIR=./data
